# Squarespace → Hugo URL redirects (301 = permanent, preserves SEO)

# Blog posts — Squarespace used /blog/slug, Hugo uses /blog/slug/ (same, with trailing slash)
/blog/:slug     /blog/:slug/    301

# Old page slugs
/home           /               301
/home-2         /               301
/james-book     /james-book/    301
/contact-1      /about/#contact 301
/contact-2      /about/#contact 301
/contact        /about/#contact 301
/contact/       /about/#contact 301
/ai-for-christians  /ai-for-christians/  301
/about          /about/         301

